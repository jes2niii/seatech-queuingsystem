<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Default: disallow cleartext globally. Production traffic should always
        use HTTPS. We only allow cleartext for local development IPs.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <!--
        Development server IPs. Each entry is an exact match. Add the IP
        addresses of your local network servers here as needed. The previous
        "192.168.0.0" / "192.168.1.0" entries were misleading because Android
        matches the <domain> literal, not a subnet.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Localhost / emulator -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Common local development server IPs -->
        <domain includeSubdomains="true">192.168.0.231</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.1.231</domain>
    </domain-config>
</network-security-config>
